{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash",
			"migrations_dir": "../../migrations",
			"database_id": "194f73a7-0bed-435b-86dc-1f2a8184aa9e",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash",
		},
	],
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
	"vars": { "EMDASH_SITE_URL": "https://emdash.georgeblack.workers.dev" },
}