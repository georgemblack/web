---
import { subtitle, url, preview, images, readMore } from "../util/Format";
import type { Post } from "../util/Format";
import LinkIcon from "./LinkIcon.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="posts">
  {
    posts.map((item) => (
      <article>
        <h1>
          <a href={url(item)}>{item.title}</a>
        </h1>
        <p class="subtitle">
          {item.external_link && <LinkIcon />}
          {item.external_link && " "}
          {subtitle(item)}
        </p>
        <Fragment set:html={preview(item)} />
        {item.gallery && (
          <div class="image-grid">
            {images(item).map((image) => (
              <a href={url(item)}>
                <img src={image.src} alt={image.alt} />
              </a>
            ))}
          </div>
        )}
        {readMore(item) && (
          <a class="read-more-button" href={url(item)}>
            <p>Read More &#8594;</p>
          </a>
        )}
      </article>
    ))
  }
</div>
