---
import { getLiveEntry } from "astro:content";
import Post from "../layouts/Post.astro";
import { cacheControlForPost } from "../util/Cache";

const { slug } = Astro.params;
const { entry, error } = await getLiveEntry("posts", { slug: slug ?? "" });

// Astro reports a missing live-loader entry as an error rather than an absent
// entry, so distinguish it from an actual failure talking to the data source.
if (error?.name === "LiveEntryNotFoundError") {
  return new Response("Not found", { status: 404 });
}
if (error) return new Response("Failed to load post", { status: 502 });
if (!entry) return new Response("Not found", { status: 404 });

const post = entry.data;

Astro.response.headers.set(
  "Cache-Control",
  cacheControlForPost(post.published),
);
---

<Post post={post}>
  <Fragment set:html={post.content_html} />
</Post>
