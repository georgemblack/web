---
import { env } from "cloudflare:workers";
import PostList from "../components/PostList.astro";
import PostPagination from "../components/PostPagination.astro";
import { listVisiblePublishedPosts } from "../data/posts";
import Page from "../layouts/Page.astro";
import {
  cacheControlForPost,
  STANDARD_CONTENT_CACHE_CONTROL,
} from "../util/Cache";

const PAGE_SIZE = 20;
const results = await listVisiblePublishedPosts(env.WEB_DB, PAGE_SIZE + 1, 0);
const selected = results.slice(0, PAGE_SIZE).map((post) => post.data);
const hasOlderPosts = results.length > PAGE_SIZE;

Astro.response.headers.set(
  "Cache-Control",
  selected[0]
    ? cacheControlForPost(selected[0].published)
    : STANDARD_CONTENT_CACHE_CONTROL,
);
---

<Page title="Home">
  <PostList posts={selected} />
  <PostPagination page={1} hasOlderPosts={hasOlderPosts} />
</Page>
