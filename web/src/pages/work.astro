---
export const prerender = true;

import Page from "../layouts/Page.astro";
---

<Page title="Work">
  <h1>Work</h1>
  <ul>
    <li>
      <a
        href="https://developers.cloudflare.com/changelog/post/2026-05-12-access-login-page-refresh/"
        >Refreshed Access login page</a
      >
    </li>
    <li>
      <a
        href="https://developers.cloudflare.com/changelog/post/2026-06-04-idp-federation/"
        >Share identity providers across accounts with IdP federation</a
      >
    </li>
    <li>
      <a
        href="https://developers.cloudflare.com/changelog/post/2026-08-25-service-token-status-controls/"
        >Temporarily turn off Access service tokens</a
      >
    </li>
    <li>
      <a
        href="https://developers.cloudflare.com/changelog/post/2026-08-25-service-token-rotation-grace-periods/"
        >Grace periods for service token rotation</a
      >
    </li>
    <li>
      <a
        href="https://developers.cloudflare.com/changelog/post/2026-08-26-service-token-secret-format/"
        >Access service token secrets use a scannable format</a
      >
    </li>
  </ul>
</Page>
